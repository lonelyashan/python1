    setlocale(LC_ALL, "RU");
    cout << fixed << setprecision(8); 
    cout << "параметр а = " << ap << ", omega = " << omega << endl;
    cout << "интервал: [" << ts << ", " << te << "]" << endl;
    euler(0.01);
    imeuler(0.01, 1e-3, quaz);
    imeuler(0.01, 1e-3, three);
    imeuler(0.01, 1e-5, quaz);
    imeuler(0.01, 1e-5, three);
    return 0;
}
